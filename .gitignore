# Issue #50 traces/ — local-only after 2026-05-21 (user directive).
# All trace runs, summaries, sampler logs, and analysis docs are kept on the
# host machine and in C:\PiPreserved_*_2026-*\ backups; not in version control.
traces/

# Run-PiCompute.ps1 redirected stdout/stderr per-run logs
run_5B_*.log
run_5B_*.log.err

# All log files (run logs, trace tool logs, sampler logs, etc.) are local-only.
# Case-insensitive — explicit patterns for systems with core.ignorecase=false.
*.log
*.LOG

# Claude-session workflow scratch scripts (underscore-prefix convention)
_*.ps1

# Local Claude Code session metadata
sessions/
PERF_SESSION_*.md

# Claude auto-memory lives under ~/.claude — guard against a misdirected
# relative-path write landing a memory/ dir in the repo working tree.
/memory/
